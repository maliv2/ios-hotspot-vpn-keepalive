<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.mali.pftun</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/local/bin/pftun</string>
        <string>run</string>
        <!-- Optional overrides, add before the closing tag of this array (each flag and its value are separate strings):
             -b bridge-if   -i vpn-if   -u vpn-config-uuid   -n extension-process-name   -m limit-mb -->
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/var/jb/var/log/pftun.log</string>
    <key>StandardErrorPath</key><string>/var/jb/var/log/pftun.log</string>
</dict>
</plist>
